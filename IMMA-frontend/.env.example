# API origin in production (dev uses Vite proxy for /api → localhost:8000)
# VITE_API_BASE=https://your-api.example.com

# Langfuse browser feedback (public key only — never the secret key)
NEXT_PUBLIC_LANGFUSE_PUBLIC_KEY=pk-lf-...
NEXT_PUBLIC_LANGFUSE_HOST=https://cloud.langfuse.com

# Vite aliases (optional if you prefer VITE_ prefix)
# VITE_LANGFUSE_PUBLIC_KEY=pk-lf-...
# VITE_LANGFUSE_HOST=https://cloud.langfuse.com
